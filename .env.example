# Copy to .env and fill in values for your DrayTek.

ROUTER_HOST=192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=changeme

# Poll interval (seconds). 10 is a good default for bandwidth.
POLL_INTERVAL=10

# How many days of samples to keep in SQLite.
RETENTION_DAYS=30

# Set to 1 to allow self-signed HTTPS on the router.
ROUTER_VERIFY_SSL=0

# http or https
ROUTER_SCHEME=http
