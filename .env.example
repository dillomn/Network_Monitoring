# Copy to .env and fill in values for your DrayTek.

ROUTER_HOST=192.168.1.1
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=admin
ROUTER_SSH_PASSWORD=changeme

# Seconds between poll cycles. 1s gives ~live updates; SSH session is kept
# open across polls so this is cheap on the router.
POLL_INTERVAL=1

# How many days of samples to keep in SQLite.
RETENTION_DAYS=30

# Unit of the integers inside `show traffic <ip>`. Hit
# /debug/ssh/raw-traffic?ip=<ip> and pick the row whose bps matches the
# DrayTek's Data Flow Monitor page. Choices:
#   bytes_per_minute     (Vigor 2762n original assumption)
#   bytes_per_second
#   bits_per_second
#   kilobits_per_second  (Vigor 2765 series — default)
#   kilobytes_per_second
TRAFFIC_UNIT=kilobits_per_second
