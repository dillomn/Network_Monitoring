# Copy to .env and fill in values for your DrayTek.

ROUTER_HOST=192.168.1.1
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=admin
ROUTER_SSH_PASSWORD=changeme

# Seconds between poll cycles. 5s gives near-live updates; the SSH session
# is kept open so this is cheap on the router.
POLL_INTERVAL=5

# How many days of samples to keep in SQLite.
RETENTION_DAYS=30

# Unit of the integers inside `show traffic <ip>`. Use the calibration
# endpoint to confirm which one matches your firmware. Choices:
#   bytes_per_minute     (Vigor 2762n original assumption)
#   bytes_per_second
#   bits_per_second      (Vigor 2765 series — default)
#   kilobits_per_second
#   kilobytes_per_second
TRAFFIC_UNIT=bits_per_second
