# Copy to .env and fill in values for your DrayTek.

ROUTER_HOST=192.168.1.1
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=admin
ROUTER_SSH_PASSWORD=changeme

# Seconds between poll cycles. 1s gives ~live updates; SSH session is kept
# open across polls so this is cheap on the router.
POLL_INTERVAL=1

# How many days of samples to keep in SQLite.
RETENTION_DAYS=30

# UDP port the NetFlow v9 collector listens on. Must match
# "Collector Port" under the router's System Maintenance → NetFlow page.
NETFLOW_PORT=2055

# (legacy, ignored on the primary code path) Unit for the deprecated
# `show traffic <ip>` buffer. Still used by /debug/ssh/raw-traffic only.
TRAFFIC_UNIT=kilobits_per_second
