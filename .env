# Copy to .env and fill in values for your DrayTek.

ROUTER_HOST=192.168.1.1
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=admin
ROUTER_SSH_PASSWORD=admin

# Poll interval (seconds). 10–60 is sensible; the router stores per-minute
# samples internally so polling faster than 60s mostly costs CPU for no
# extra resolution.
POLL_INTERVAL=10

# How many days of samples to keep in SQLite.
RETENTION_DAYS=30
